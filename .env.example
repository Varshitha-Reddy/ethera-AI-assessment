# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ethera
DATABASE_URL=postgresql://postgres:postgres@db:5432/ethera
# Optional read-only PostgreSQL replica; leave blank to use the primary
READ_DATABASE_URL=

# Redis Cache Configuration
REDIS_URL=redis://redis:6379/0
ENABLE_CACHE=true

# Kafka Configuration
KAFKA_BROKERS=kafka:9092
KAFKA_ENABLED=true

# Frontend API Configuration
# For local Docker Compose, leave blank — auto-detects http://localhost:8000
# For deployed frontend (Netlify/Vercel), set to your live backend URL
REACT_APP_API_URL=

# API Configuration
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MINUTES=60
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-start
RATE_LIMIT_ENABLED=true
REQUESTS_PER_MINUTE=60
GLOBAL_REQUESTS_PER_MINUTE=1000
CORS_ORIGINS=http://localhost:3000

# Logging Configuration
LOG_LEVEL=INFO
JSON_LOGS=true

# Feature Flags
ENABLE_AUTH=true

# Observability (optional locally)
OTEL_SERVICE_NAME=ethera-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
GRAFANA_ADMIN_PASSWORD=replace-me
