{
  "title": "Ethera API SLOs",
  "uid": "ethera-api",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {"type":"stat","title":"Requests / second","gridPos":{"x":0,"y":0,"w":8,"h":6},"targets":[{"expr":"sum(rate(http_requests_total[5m]))"}]},
    {"type":"stat","title":"5xx error ratio","gridPos":{"x":8,"y":0,"w":8,"h":6},"targets":[{"expr":"sum(rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total[5m])), 0.001)"}]},
    {"type":"stat","title":"p95 latency","gridPos":{"x":16,"y":0,"w":8,"h":6},"targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))"}]},
    {"type":"timeseries","title":"Requests by route/status","gridPos":{"x":0,"y":6,"w":24,"h":9},"targets":[{"expr":"sum by (route,status) (rate(http_requests_total[5m]))","legendFormat":"{{route}} {{status}}"}]}
  ]
}
